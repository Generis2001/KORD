# NEAR network selection: "testnet" (default) or "mainnet"
NEAR_NETWORK=testnet

# RPC endpoint (defaults: https://test.rpc.fastnear.com for testnet, https://free.rpc.fastnear.com for mainnet)
NEAR_RPC_URL=https://test.rpc.fastnear.com

# Server account for default verifier approvals and legacy demonstration liquidity.
# Research fees are funded from each user's agent wallet.
# Testnet example: your-treasury.testnet | Mainnet example: your-treasury.near
NEAR_ACCOUNT_ID=your-treasury.testnet

# Private key for the treasury account. Never commit real credentials in .env.
NEAR_PRIVATE_KEY=ed25519:...

# Demo rate: how many yoctoNEAR one logical cent maps to (default 0.001 NEAR per cent).
YOCTO_PER_CENT=1000000000000000000000
MANDATE_DB=mandate.db
# Optional cloud persistence; DATABASE_URL is also supported.
# POSTGRES_URL=postgresql://user:password@host/database?sslmode=require

# Keep the derivation seed stable. If omitted, NEAR_PRIVATE_KEY is used.
# AGENT_WALLET_MASTER_KEY=<stable-server-secret>
# Default live testnet staking providers (no mainnet defaults).
# NEAR_STAKING_POOL_ID=kiln.pool.f863973.m0
# USDT_STAKING_CONTRACT_ID=usdt.mandate-live-20261029.testnet
# Reserve-based Ref Finance testnet swaps are the default.
# TESTNET_DEX_CONTRACT_ID=ref-finance-101.testnet
# TESTNET_DEX_POOL_ID=57
# Explicit compatibility opt-in only: SWAP_MODE=legacy_demo

# ==============================================================================
# MAINNET SAFETY CONTROLS (Required only when NEAR_NETWORK=mainnet)
# ==============================================================================
# 1. Master toggle: must be set explicitly to "true" to allow mainnet execution.
ALLOW_MAINNET=false

# 2. Confirmation phrase: must match exactly to guard against accidental spend.
MAINNET_CONFIRMATION=I_CONFIRM_SPENDING_REAL_FUNDS

# 3. Maximum spend ceilings (in logical cents):
# Hard upper limit on single transaction payout (default 5000 cents = $50.00)
MAINNET_MAX_PAYMENT_CENTS=5000
# Hard upper limit on cumulative mandate budget (default 20000 cents = $200.00)
MAINNET_MAX_TOTAL_BUDGET_CENTS=20000

# ==============================================================================
# OPTIONAL VERIFIED RESEARCH FEES (testnet NEAR only; no paid API keys)
# ==============================================================================
# Explicit command suffix: ; research fee 0.01 NEAR
ESCROW_CONTRACT_ID=mandate-generis-escrow.testnet
AGENT_RESEARCHER=mandate-generis-researcher.testnet
# Defaults to the server account/key above. Set BOTH values to override the verifier.
# The verifier must differ from the paid researcher.
# VERIFIER_ACCOUNT_ID=your-verifier.testnet
# VERIFIER_PRIVATE_KEY=ed25519:...
