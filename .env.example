# NEAR network selection: "testnet" (default) or "mainnet"
NEAR_NETWORK=testnet

# RPC endpoint (defaults: https://test.rpc.fastnear.com for testnet, https://free.rpc.fastnear.com for mainnet)
NEAR_RPC_URL=https://test.rpc.fastnear.com

# The treasury account that pays agents.
# Testnet example: your-treasury.testnet | Mainnet example: your-treasury.near
NEAR_ACCOUNT_ID=your-treasury.testnet

# Private key for the treasury account. Never commit this file.
NEAR_PRIVATE_KEY=ed25519:...

# Demo rate: how many yoctoNEAR one logical cent maps to (default 0.001 NEAR per cent).
YOCTO_PER_CENT=1000000000000000000000
MANDATE_DB=mandate.db

# ==============================================================================
# MAINNET SAFETY CONTROLS (Required only when NEAR_NETWORK=mainnet)
# ==============================================================================
# 1. Master toggle: must be set explicitly to "true" to allow mainnet execution.
ALLOW_MAINNET=false

# 2. Confirmation phrase: must match exactly to guard against accidental spend.
MAINNET_CONFIRMATION=I_CONFIRM_SPENDING_REAL_FUNDS

# 3. Maximum spend ceilings (in logical cents):
# Hard upper limit on single transaction payout (default 5000 cents = $50.00)
MAINNET_MAX_PAYMENT_CENTS=5000
# Hard upper limit on cumulative mandate budget (default 20000 cents = $200.00)
MAINNET_MAX_TOTAL_BUDGET_CENTS=20000

# ==============================================================================
# ESCROW CONTRACT MODE (DEMO_EXECUTOR=escrow)
# ==============================================================================
# The verifier signs approve_payment. It must be a different account from treasury and agents.
ESCROW_CONTRACT_ID=your-escrow.testnet
VERIFIER_ACCOUNT_ID=your-verifier.testnet
VERIFIER_PRIVATE_KEY=ed25519:...
